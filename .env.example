# ============================================================
# REASONS Backend — Archivo de configuración de entorno
# ============================================================
# 1. Copia este archivo y renómbralo a: .env
# 2. Rellena los valores con tu configuración local de PostgreSQL
# 3. NUNCA subas el archivo .env al repositorio
# ============================================================

# Configuración de PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=reasons_db
DB_USER=postgres
DB_PASSWORD=TU_CONTRASEÑA_AQUI

# Puerto del servidor Express
PORT=3000

# Clave secreta para firmar tokens JWT (cambia esto por algo único y largo)
JWT_SECRET=una_clave_secreta_muy_larga_y_segura_cambiar_esto
